ALProtocol PlayerInfo_IconBgk
{
	long id[头像框唯一Id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
	bool viewed[是否查看过];
}

/**********************************************************
 *玩家气泡框信息
 **********************************************************/
ALProtocol PlayerInfo_Bubble
{
	long id[气泡框唯一Id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
	bool viewed[是否查看过];
}

/**********************************************************
 *玩家聊天表情包信息
 **********************************************************/
ALProtocol PlayerInfo_ChatEmoteGroup
{
	long id[表情包唯一id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
	bool viewed[是否查看过];
}

ALProtocol PlayerInfo_CuteActor[玩家Q版形象信息]
{
	long id[Q版形象唯一id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
	bool viewed[是否查看过];
}

/**********************************************************
 *玩家房间皮肤信息
 **********************************************************/
ALProtocol PlayerInfo_RoomSkin[玩家房间皮肤]
{
	long id[房间皮肤唯一id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
