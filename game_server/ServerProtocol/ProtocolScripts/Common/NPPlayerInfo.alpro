/**********************************************************
 *玩家记录信息
 **********************************************************/
ALProtocol PlayerInfo_Record
{
	Enum.NPPlayerPro.ENPPlayerRecordParam type;
	long count;
}

/**********************************************************
 *玩家登录过的服务及服务器上的角色信息
 **********************************************************/
  ALProtocol NP_SYS_PlayerJoinedUSInfo[玩家登录过的服务及服务器上的角色展示信息]
 {
    Common.NPCommonObj.NP_SYS_ServerItem serverItem[服务器信息];
    long cid[玩家cid];
    string playerName[玩家名];
    Common.NPCommonObj.PlayerInfo_IconShow iconShowInfo[头像展示信息];
    long lastLoginTimeMs[最后登录时间];
    bool isFreeze[是否被封禁];
    long freezeTimeMs[封禁结束时间];
 }

ALProtocol CommPlayerInfo_FlourishCategory[玩家繁荣度信息]
{
	Enum.NPPlayerPro.ENPFlourishCategory category;
	long value;
}

ALProtocol PlayerInfo_Report[玩家举报数据]
{
	long targetCid[目标玩家CID];
	string contenxt[举报内容];
}