JavaPackage NP2US_R.p002_GSOp;

/**********************************************************
 * 连接服务器发送请求到用户处理服务器注册用户的连接服务器对象
 **********************************************************/
ALProtocol NP2US_R_002_001_RegUserGate <2, 1>
{
	long cid;
	long sessionId;
	int dealerSerialize[消息处理序列号];
	string clientIp;
	string customData;
	string areaTag[GS服务器的areaTag，用于聊天服务器选服];
}
