JavaPackage GOM2CD_R.gom_p001_DataOp;

/**********************************************************
 * 请求同步相关的数据
 * 此协议是数据同步的协议
 * 不论是初始化同步还是后续同步，实际都使用这个协议处理
 **********************************************************/
ALProtocol GOM2CD_R_001_002_SyncData <1, 2>
{
	int dataType[数据类型];
	long groupId[分组Id];
	int usId[US服务器Id];
	
	ByteBuffer[] dataList[数据队列];
}
