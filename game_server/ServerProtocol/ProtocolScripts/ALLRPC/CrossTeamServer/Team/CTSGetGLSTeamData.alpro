JavaPackage ALLRPC.CrossTeamServer.Team;

import Common.ServerObj.alpro;

ALProtocol CTSGetGLSTeamData_Req
{
	long teamId[队伍实例ID];
}

ALProtocol CTSGetGLSTeamData_Return
{
	Common.ServerObj.ServerObj_FirstTeam_Team teamData[GLS GroupMgr所需的队伍数据];
}

