	FRIEND_NUM_MAX_RECORD[玩家好友数量历史记录最高值];
	CONSORT_BLESSING_SKILL_UPGRADE_TIMES[妃子加护技能升级次数];
	FINISH_DAILY_QUEST[完成日常任务];
