JavaPackage NPGS2GC.p001_BasicOp;
csharpspace NPGS2GC.p001_BasicOp;

/**********************************************************
 * 在服务器因为缓存溢出无法发送消息时，通知客户端的消息。收到此消息需要进行重新登录处理
 **********************************************************/
ALProtocol NPGS2GC_001_010_OnMsgInvalid <1, 10>
{
	long sessionId;
}
