JavaPackage Common.OfflineRewardEnum;
csharpspace Common.OfflineRewardEnum;

ALEnum EOfflineRewardEnum[玩家离线数据类型，Hopen特别强调：需要推送客户端需要加C_]
{
	GM[玩家GM命令];
	
	DINNER_OWNER_RESULT[宴会主人结算数据];
	DINNER_BE_JOINED[玩家宴会有其他玩家加入];
	
	NO_USE_3[未使用3];
	
	FRIEND_ACCEPT_APPLY[收到好友申请];
	FRIEND_AGREE_APPLY[同意好友申请];
	FRIEND_REMOVE[移除好友];
	
	ADULT_MARRY_ACCEPT_PERSON_APPLY[子嗣联姻收到个人邀请];
	ADULT_MARRY_CANCEL_PERSON_APPLY[子嗣联姻取消个人邀请];
	ADULT_MARRY_REFUSE_PERSON_APPLY[子嗣联姻拒绝个人邀请];
	ADULT_MARRY_AGREE_PERSON_APPLY[子嗣联姻同意个人邀请];
	ADULT_MARRY_AGREE_SERVER_APPLY[子嗣联姻同意全服联姻邀请];

	JOIN_GUILD[加入联盟];
	QUIT_GUILD[离开联盟];
	CHG_PLAYER_RECORD[变更玩家记录];
	
	ADULT_MARRY_REWARD[子嗣联姻奖励展示（注：只有展示，实际奖励通过邮件领取）];

	ORDER_PAY[订单支付];
	
	MARS_MINE_TEAM_SETTLE[火星矿产队伍结算];

	C_ORDER_DELIVERY[订单发货];
	
	MARS_EXPLORE_PVP_LOG[火星探索-PVP日志];
	MARS_TEAM_OCCUPY_RESULT[火星探索-占领火星矿结果];
	
	GUILD_MARS_HELP_SUC[公会火星互助-成功互助];
	
	GUILD_BOX_DISPATCH[联盟宝箱-玩家下发领取邮件];
	
	GUILD_MARS_HELP_BE_AUTO_DEALED[公会火星互助-被自动帮助];
	GUILD_MARS_HELP_AUTO_DEAL[公会火星互助-自动帮助求助];
	
	FORBID_CHAT[禁言];
	LIFT_FORBID_CHAT[解除禁言];
	MARS_RALLY_JOIN_TO_WAIT[火星集结-加入到达后切换等待状态];
	MARS_RALLY_JOIN_FAIL_BACK[火星集结-加入失败后遣返状态];
}
