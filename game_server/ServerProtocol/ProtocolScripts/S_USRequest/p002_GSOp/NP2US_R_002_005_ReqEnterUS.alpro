JavaPackage NP2US_R.p002_GSOp;

/**********************************************************
 * 连接服务器发送请求到用户处理服务器注册用户的连接服务器对象
 **********************************************************/
ALProtocol NP2US_R_002_005_ReqEnterUS <2, 5>
{
	string uid;
	long gsSessionId[gs连接对象的sessionId，用于处理结果获取对象用];
	long gsInfoSerialize[GS对应的信息序列号];
	string customData;
}
