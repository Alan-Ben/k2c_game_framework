JavaPackage GOM2CD_R.gom_p001_DataOp;

/**********************************************************
 * 针对对应数据集的数据有需要做处理的时候通过本协议处理
 * 一般用于查询或者分配数据，实际的原始数据还是要在US进行处理
 **********************************************************/
ALProtocol GOM2CD_R_001_010_CustomDataOp <1, 10>
{
	int dataType[数据类型];
	long groupId[分组Id];
	
	ByteBuffer opData[处理的数据内容];
}
