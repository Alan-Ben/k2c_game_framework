	PLAYER_CONSORT_CHARM_ADD[玩家妃子加护值增加记录（不包括初始值）];
	FRAM_COLLECT_SUM[农场收获金币数量];
	ARENA_SELECT_ATTACK_TIME[竞技场选择攻击次数];
	GUILD_CONSTRUCT_TIMES[联盟建设次数];
