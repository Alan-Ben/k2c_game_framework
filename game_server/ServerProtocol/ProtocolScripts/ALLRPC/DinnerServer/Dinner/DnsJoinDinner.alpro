JavaPackage ALLRPC.DinnerServer.Dinner;


ALProtocol DnsJoinDinner_Req
{
	long groupId;
	long instanceId;
	bool isPlayer[是否玩家];
	long joinerId;
	long joinerScore[参与宴会带来的宴会人气];
}

ALProtocol DnsJoinDinner_Return
{
}

