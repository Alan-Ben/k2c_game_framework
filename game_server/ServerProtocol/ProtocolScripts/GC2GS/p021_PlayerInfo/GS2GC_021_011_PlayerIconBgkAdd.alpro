/**********************************************************
 * 玩家获得新头像框的时候的推送消息
 **********************************************************/
ALProtocol GS2GC_021_011_PlayerIconBgkAdd <21, 11>
{
	long id[头像框唯一Id];
	int expireTimeTagS[超时时间标记，单位秒。-1表示永久];
	bool viewed[是否查看过];
}