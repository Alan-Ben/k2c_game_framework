ALEnum ENPPlayerConditionType[玩家条件类型]
{
    NONE;
    UNUSE_S_LOGIC_EVENT[废除 监听到事件触发 S_LOGIC_EVENT:事件名称:事件参数:n:m];
    CS_VALUE[值范围 CS_VALUE:ENPPlayerValueType:min:max];
    CS_BUF_LAYER[BUFF层级 CS_BUF_LAYER:buf_id:min:max];
    CS_HAS_ITEM[拥有物品  CS_HAS_ITEM:itemType-item_id:min:max];
    CS_HAS_BUILDING[玩家已放置建筑 CS_HAS_BUILDING:building_id];
    CS_JUD_SIM_UNLOCK[判断简要解锁的解锁信息 CS_JUD_SIM_UNLOCK:sim_unlock_id];
    CS_SPECIAL[特殊判断条件 CS_SPECIAL:ENPPlayer_CS_SpecialCondition];
    C_ID_JUDGE[针对Id进行判断 C_ID_JUDGE:EPlayer_C_IdJudgeFunc:id];
    CS_ID_JUDGE[针对Id进行判断 CS_ID_JUDGE:ENPPlayer_CS_IdJudgeFunc:id];
    CS_RECORD_PARAM[玩家计数 CS_RECORD_PARAM:ENPPlayerRecordParam:min_value（:max_value）];
	CS_QUEST_COUNT[任务完成次数 CS_QUEST_COUNT:quest_id:min_value（:max_value）];
	CS_QUEST_DOING[正在进行的任务 CS_QUEST_DOING:quest_id（:quest_step_ID:quest_target_ID）];
	CS_EVENT_RECORD[玩家事件记录计数 CS_EVENT_RECORD:ENPPlayerEventRecordType:sub_id:min_value（:max_value），sub_id取-1表示所有子计数之和注意，sub_id使用负数时需要用括号括起来，否则会被当成分隔符无法读取例： '（-1）'];
	C_GUILD_SELF_HAVE_PERMISSION[联盟自己的职位是否拥有对应权限 C_GUILD_SELF_HAVE_PERMISSION:EGuildPermissionType];
	C_HAS_TREASURE_MAP[拥有藏宝图 C_HAS_TREASURE_MAP（:id配置id）];
    CS_QUEST_STEP_IS_DONE[是否完成任务 CS_QUEST_STEP_IS_DONE:quest_id:step_id];
	CS_VARIABLE[某高级公式的值范围 CS_VARIABLE:min:max:高级公式];
	C_PLAYER_CAN_LEVEL_UP[玩家可以升级 C_PLAYER_CAN_LEVEL_UP];
	C_PLAYER_IN_SPACE_POS[玩家在大地图指定范围 C_PLAYER_IN_SPACE_POS:mapid（地图id）:位置（Vector3）:范围（float）];
	CS_HAS_HERO[拥有指定大臣中的n个 CS_HAS_HERO:hero1&hero2:（n）];
	CS_BUILDING_FUNC_LEVEL[玩家已放置建筑功能等级 CS_BUILDING_FUNC_LEVEL:building_id:EBuildingFuncEnum（:minLevel:maxLevel）];
	CS_CHAPTER_STAGE_PASSED[章节是否通过指定关卡 CS_CHAPTER_STAGE_PASSED:stageId];
	CS_CONSORT_SKILL[情人技能解锁检查 CS_CONSORT_SKILL:情人ID:技能ID:最小等级（:最大等级 默认-1）];
	C_FUNC_UNLOCK_IS_SHOW[系统解锁弹窗是否已经展示过 C_FUNC_UNLOCK_IS_SHOW:ENPFunctionType];
	CS_HERO_REACH_STAR_NUM[达到指定星级大臣数量 CS_HERO_REACH_STAR_NUM:星级:min（:max）];
	CS_LEVY_SUM[征收累计数量 CS_LEVY_SUM:ELevy_Type:min（:max）];
	C_ACHIEVE_IS_DONE[成就是否已经全部完成领奖 C_ACHIEVE_IS_DONE:achieve_id];
	C_WEEK_CARD_STAT[周卡状态是否满足 C_WEEK_CARD_STAT:stat（EWeekCardStat）];
	C_ADD_PACK_NEED_DOWNLOAD[是否有增量包需要下载 C_ADD_PACK_NEED_DOWNLOAD];
	C_CHAPTER_BLOCK_EVENT_DEAL_DONE[关卡格子上事件是否处理完成 C_CHAPTER_BLOCK_EVENT_DEAL_DONE:关卡格子配表id chapter_stage_block_id （:挂起事件是否视为事件已经完成bool, 默认为true）];
	C_CLOTHES_HANDBOOK_CAN_REWARD[图鉴是否可以领奖 C_CLOTHES_HANDBOOK_CAN_REWARD:TRUE（或者FALSE）];
	C_CONSORT_INTIMACY_STEP_REACHED[妃子亲密度阶段是否达到 C_CONSORT_INTIMACY_STEP_REACHED:妃子consort_id:阶段intimacy_step];
	CS_CONSORT_RES_COUNT[指定家人指定资源数量  CS_CONSORT_RES_COUNT:家人ID:EBagItemUse_ConsortDrawShowType:min:max];
	CS_CONSORT_LIKE_COUNT[指定家人（未获得）好感度数值  CS_CONSORT_LIKE_COUNT:家人ID:min:max];
	C_HAS_OWNER_DINNER_REWARD[是否有自身宴会奖励未领取 C_HAS_OWNER_DINNER_REWARD];
	C_EVENING_DUNGEON_ACTIVITY_STATE[晚间副本活动状态 C_EVENING_DUNGEON_ACTIVITY_STATE:（EEveningDungeonActivityState:PREVIEW:ONGOING:END:CLOSE）];
    C_HOTFIX_CONDITION[热更条件类型 C_HOTFIX_CONDITION:热更条件类型:参数];
    C_MIDDAY_DUNGEON_ACTIVITY_STATE[午间副本活动状态 C_MIDDAY_DUNGEON_ACTIVITY_STATE:（EMiddayDungeonActivityState:PREVIEW:ONGOING:END）];
    C_SEVEN_DAY_LOGIN_HAD_DRAW_COUNT[七天登录已领取奖励数量 C_SEVEN_DAY_LOGIN_HAD_DRAW_COUNT:int];
    CS_HAS_CONSORT[拥有指定妃子中的n个 CS_HAS_CONSORT:consort1&consort2:（n）];
    C_ACTIVITY_STATE[活动状态 C_ACTIVITY_STATE:EActivityState:activityId];
    CS_HAD_UNLOCK_INN_DISH[是否解锁旅店菜品 CS_HAD_UNLOCK_INN_DISH:菜品id];
    CS_HAD_UNLOCK_BUILDING_PRODUCT[是否解锁建筑产品 CS_HAD_UNLOCK_BUILDING_PRODUCT:建筑id:产品id];
	C_CONSORT_CALL_DIALOG_NOT_SHOW_CG[妃子邀约对话是否不展示CG];
    S_IS_SYSTEM_QUEST_GROUP_DONE[是否完成系统任务组 S_IS_SYSTEM_QUEST_GROUP_DONE:group_id];
    CS_MARS_BUILDING_LVL[火星指定建筑等级判断 CS_MARS_BUILDING_LVL:建筑id:min_value（:max_value）];
    CS_MARS_TECH_LVL[火星指定科技等级判断 CS_MARS_TECH_LVL:科技id:min_value（:max_value）];
    CS_CONSORT_UNLOCK_CG_NUM[解锁妃子CG的数量 CS_CONSORT_UNLOCK_CG_NUM:min_value（:max_value）];
	CS_CHECK_PLAYER_PERMISSION[检查玩家是否拥有指定权限 CS_CHECK_PLAYER_PERMISSION:权限配置ID];
    CS_MARS_PEOPLE_NUM[火星人口数量判断 CS_MARS_PEOPLE_NUM:min_value（:max_value）];
    CS_MARS_IDLE_PEOPLE_NUM[火星空闲人口数量判断 CS_MARS_IDLE_PEOPLE_NUM:min_value（:max_value）];
    C_LOVER_COLLECT_HAS_TARGET[情人收集是否有指定目标情人];
    C_LOVER_COLLECT_HAD_DRAW[情人收集是否已抽取指定情人];
	C_SPECIAL[客户端特殊判断条件 C_SPECIAL:EClientSpecialConditionType];
}

ALEnum ENPPlayer_CS_SpecialCondition[玩家特殊的条件判断]
{
    NONE;
    C_IS_IN_TUTORIAL[是否在引导中];
    C_CITY_SCENE_IS_SHOW[主城场景是否显示];
    C_ROOM_SCENE_IS_SHOW[卧室场景是否显示];
    C_CHILD_HAS_UNMARRIED_ADULT[是否有可以联姻的成年子嗣];
    C_CHILD_CAN_TRAIN[是否有可以培养的子嗣];
    C_HAVE_ANNOUNCEMENT[是否拥有运营公告];
    C_HAVE_QUESTIONNAIRE[是否有问卷调查];
    C_HAVE_RANK_RUSH_ACTIVITY[是否有限时冲榜活动];
	C_ANECDOTE_IN_EVENT_PROCESS[是否有经营事件处理中];
	CS_QUEST_ALL_DONE[所有主线任务完成];
	C_FUNCTION_REWARD_ALL_GET[功能解锁奖励是否全部领取完毕];
	C_HAVE_STEP_REWARD_ACTIVITY[是否有阶段奖励活动];
	C_CONSORT_HAS_UNCLAIMED_CG_REWARD[是否有未领取的妃子cg奖励];
	CS_IS_ARRIVE_MARS[是否已到达火星];
	C_FIRST_RECHARGE_REWARD_IS_ALL_GET[首充奖励是否已经全部领取];
	C_HAVE_AVAIABLE_GEM_GIFT_PACK[是否有可用钻石礼包];
	C_CAN_USE_WEB_RECHARGE[是否可以使用网页充值];
	C_STAGE_GOAL_IS_ALL_DONE[阶段目标是否全部完成];
	C_IS_LANDING_MARS[是否已经登录火星];
	C_CUR_WND_HERO_CAN_UPGRADE[当前窗口的顾问是否可以升级];
	C_TRAVEL_HAS_EVENT_UNTREATED[游历中是否有未处理事件];
	C_HAVE_COUNT_DOWN_EVENT[是否有倒计时事件];
	C_COUNT_DOWN_EVENT_CAN_GET_REWARD[倒计时事件是否可以领取奖励];
	C_CUR_IS_IN_CHAPTER_BOSS[当前是否在章节boss战中];
	C_CUR_CHAPTER_BOSS_POWER_IS_ENOUGH[当前boss战战力是否足够];
}
ALEnum ENPPlayer_CS_IdJudgeFunc[玩家特殊的条件判断-CS_ID_JUDGE]
{
    NONE;
    STAGE_GOAL_STEP_IS_DONE[阶段目标是否完成];
    HAD_GAIN_TREASURE_HUNT_ORE[是否获得过太空寻宝矿石];
    HAD_GAIN_TREASURE_HUNT_TREASURE[是否获得过太空寻宝奇物];
    HAD_COLLECT_TREASURE_HUNT_COMPOSITE[是否集齐太空寻宝组合];
    HAD_DONE_SYSTEM_QUEST_TASK[是否已完成指定系统任务];
}

ALEnum ENPPlayerVariableType[玩家的参数类型 高级公式类型]
{
    NONE;
    C_RND[随机值 c_rnd@max];
    S_RND[服务端随机值 s_rnd@max];
    CS_NUM[指定数字 cs_num@num];
    CS_VALUE[指定类型的值，如等级等 cs_value@ENPPlayerValueType];
    CS_PROPERTY[玩家属性 cs_property@ENPPlayerPropertyType];
    CS_VAR_V[对应的动态值 cs_var_v@ENPPlayerVariableVarType];
    CS_BUF_L[buf层级 cs_buf_l@buf_id];
    CS_BUFF_HAD_ACTIVE_DAY[buff已生效自然天 从1开始 cs_buff_had_active_day@buff_id];
    CS_ITEM_COUNT[物品数量 cs_item_count@item_type@sub_id];
    CS_HAS_BUILDING[是否拥有建筑 CS_HAS_BUILDING@建筑id 1=有 0=无];
    CS_PARAM[玩家系数 cs_param@ENPPlayerParam];
    CS_VALUE_ID[玩家对应Id的某一个值 cs_value_id@ENPPlayerIdValueType@value_id];
    CS_BUSINESS_BUILDING_WORKER_NUM[指定经营建筑员工数量 CS_BUSINESS_BUILDING_WORKER_NUM@建筑id）];
    CS_BUILDING_LEVEL[建筑等级 CS_BUILDING_LEVEL@建筑功能类型EBuildingFuncEnum@建筑id（如果传0为该类型下所有）];
	CS_CONDITION_BOOLEAN_V[返回条件的布尔值 CS_CONDITION_BOOLEAN_V@（条件）条件外的括号比较特殊，不可省略];
	CS_RECORD_PARAM[玩家记录 CS_RECORD_PARAM@ENPPlayerRecordParam];
	CS_EVENT_RECORD[玩家事件记录计数 CS_EVENT_RECORD@ENPPlayerEventRecordType（@sub_id）注意，sub_id使用负数时需要用括号括起来，否则会被当成分隔符无法读取例： '（-1）'];
	CS_BUILDING_LVL[已放置指定建筑的等级 CS_BUILDING_LVL@建筑ID];
    CS_SCOPE_ITEM_COUNT[范围内物品数量 CS_SCOPE_ITEM_COUNT@item_type@startSubIdS:endSubIdS];
    S_RND_FROM_SCOPE[范围内随机值 S_RND_FROM_SCOPE@startCount@endCount];
    S_RND_BASIC_ATTR[已废弃 - 随机基础属性类型 S_RND_BASIC_ATTR（@EBasicAttrType） 如果传了则是指定类型，没传则为随机];
    S_RND_ATTR_HERO[随机已拥有特长大臣 S_RND_ATTR_HERO（@ESpecAttrType） 如果传了则是指定类型，没传则为随机];
    S_RND_CONSORT[随机已拥有情人 S_RND_CONSORT];
    CS_HERO_NUM[已拥有大臣数量（可配置等级上下限，无限制即-1） CS_HERO_NUM（@min_lv@max_lv）];
    S_RND_VALUE_BY_WEIGHT[通过权重随机数值 S_RND_VALUE_BY_WEIGHT@value1：weight1；value2：weight2...];
	CS_LEVY_SUM[征收累计数量 CS_LEVY_SUM@ELevy_Type];
	CS_CLOTHES_UNIT_QUALITY_NUM[指定品质服装数量 CS_CLOTHES_UNIT_QUALITY_NUM@ENPQuality];
	CS_CONSORT_RES_COUNT[指定家人指定类型资源数量 CS_CONSORT_RES_COUNT@家人ID@EBagItemUse_ConsortDrawShowType];
	CS_CONSORT_FETTER_LEVLE[指定家人的羁绊等级 C_CONSORT_FETTER_LEVLE@家人ID];
	CS_MARS_BUILDING_LVL[指定火星建筑等级 CS_MARS_BUILDING_LVL@火星建筑ID];
	CS_MARS_BUILDING_EQUIP_LVL[指定火星建筑指定部件等级 CS_MARS_BUILDING_EQUIP_LVL@火星建筑ID@部件ID];
	CS_MARS_BUILDING_DISPATCH_NUM[指定火星建筑派遣居民数量 CS_MARS_BUILDING_DISPATCH_NUM@火星建筑ID];
}

ALEnum ENPMusuemCountType[博物馆藏品数量,筛选类型]
{
    NONE;
    QUALITY[品质];
}

ALEnum ENPPlayerValueType[玩家的值类型,高级公式 CS_VALUE的值类型]
{
    NONE;
    LVL[玩家等级];
    VIP_LVL[玩家VIP等级];
    RMB_NUM[玩家充值RMB值];
	FRIEND_COUNT[好友数量];
	HERO_NUM[大臣数量];
	HERO_IN_BUILDING_NUM[入驻建筑的大臣数量];
	EARNINGS[每秒赚速];
	CHILD_SUM[未成年子嗣数量];
	TOTAL_HERO_POWER[总大臣实力];
	TOTAL_HERO_TALENT[总大臣资质];
	CONSORT_NUM[情人数量];
	CHAPTER_POINT[章节位置 chapterId*1000+point];
	BUILDING_NUM[建筑数量];
	TOTAL_HERO_LEVEL[总大臣等级];
	TOTAL_CONSORT_INTIMACY[总情人亲密度];
	TOTAL_CONSORT_CHARM[总情人加护力];
	DAILY_CHECK_SUM[总签到天数];
	DONE_MAIN_QUEST_COUNT[主线任务完成数（如果多次完成也算1次）];
	STAGE_GOAL_DONE_STEP[阶段目标已完成阶段];
