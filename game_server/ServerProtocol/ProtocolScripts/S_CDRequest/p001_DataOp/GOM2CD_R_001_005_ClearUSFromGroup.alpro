JavaPackage GOM2CD_R.gom_p001_DataOp;

/**********************************************************
 * 此协议需要清理在数据集中US的数据
 * 一般在服务器切换所属数据集的时候会发送此协议进行处理
 **********************************************************/
ALProtocol GOM2CD_R_001_005_ClearUSFromGroup <1, 5>
{
	int dataType[数据类型];
	long groupId[分组Id];
	int usId[US服务器Id];
}
