    WEEKLY_QUEST[周任务];
    EQUIP[藏品];
	ANECDOTE[政务];
	ARENA[竞技场];
	RANK_RUSH[冲榜];
	CONSORT[情人];
	CHILD[子嗣];
	CHILD_MARRY[子嗣联姻];
	GACHA[抽卡];
	DINNER[宴会];
	HERO[骑士];
	ROOM[公主卧室];
	CITY[主城];
	MARKET[集市];
	DAILY_CHECK[每日签到];
	TOWER[爬塔];
	STAGE_GOAL[阶段目标];
	PLAYER_INFO[玩家信息];
	TRAVEL[游历];
	MAIL[邮件];
	HERO_RECOMMEND[骑士推荐];
	RANK[排行榜];
	ANNOUNCEMENT[运营公告];
