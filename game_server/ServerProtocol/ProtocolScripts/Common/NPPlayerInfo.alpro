import Enum.NPPlayerPro.alpro;
import Common.NPInclude.alpro;
import Common.PlayerShowObj.alpro;

JavaPackage Common.NpPlayerInfoObj;
csharpspace Common.NpPlayerInfoObj;

/**********************************************************
 *玩家通用展示信息
 **********************************************************/
ALProtocol PlayerInfo_CommonShow[玩家通用展示信息]
{
	long cid[玩家id];
	Common.NPCommonObj.PlayerInfo_IconShow iconShow[小头像组合信息];
	Common.CommonObj.Common_LongList attrList[属性列表];
	long cuteActorId[Q版形象id];
	long beLikeCount[被点赞次数];
	long exp[经验值];
	long vipExp[vip经验];
	long maxPower[历史最大战力];
}


/**********************************************************
 *玩家皮肤信息
 **********************************************************/
ALProtocol PlayerInfo_Skin[玩家皮肤]
{
	long skinId[皮肤ID];
	int lvl[皮肤等级];
}

/**********************************************************
 *玩家称号信息
 **********************************************************/
ALProtocol PlayerInfo_Title[普通称号]
{
	long id[称号唯一Id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
	bool viewed[是否查看过];
	int lastGainTs[最近一次获得时间];
	int gainCount[获得次数];
}

ALProtocol PlayerInfo_ComboTitle[组合称号]
{
	long preId[称号前缀];
	long sfxId[称号后缀];
	long bgId[称号底色];
}

ALProtocol PlayerInfo_ComboTitlePre[组合称号-称号前缀]
{
	long preId[称号前缀];
	bool viewed[是否查看过];
}

ALProtocol PlayerInfo_ComboTitleSfx[组合称号-称号后缀]
{
	long sfxId[称号后缀];
	bool viewed[是否查看过];
}

ALProtocol PlayerInfo_ComboTitleBg[组合称号-称号底色]
{
	long bgId[称号底色];
	bool viewed[是否查看过];
}
/**********************************************************
 *玩家头像信息
 **********************************************************/
ALProtocol PlayerInfo_Icon
{
	long id[头像唯一Id];
	int expireTimeTagS[超时时间标记，单位秒。0表示永久];
	bool viewed[是否查看过];
}

/**********************************************************
