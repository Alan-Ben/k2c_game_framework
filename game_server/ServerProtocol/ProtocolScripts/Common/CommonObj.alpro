ALProtocol Common_FloatVec
{
	float x;
	float z;
}

/**********************************************************
 * actor info
 **********************************************************/
ALProtocol Common_ActorInfo
{
	long petInstanceId[宠物实例Id，虚构的使用负数];
	long petId[宠物卡牌Id];
	int lvl;
	short star;
	short quality;
	long skin_id;
	bytebuffer cardExInfo;
	Enum.NPCommonEnum.ENPAttrGrade attrGrade[宠物资质品质];
}

/**********************************************************
 * 头像框信息
 **********************************************************/
ALProtocol Common_IconBgk
{
	long iconBgk;
	int leftTimeS;
}

/**********************************************************
 * 比赛阵容数据
 **********************************************************/
ALProtocol Common_Lineup
{
	//所选种族Id
	long raceId;
	//选择的英雄单位阵容Id队列
	Common_ActorInfo[] cardList;
    //选择的指挥官技能
    long[] cmdSkillIds;
}

/**********************************************************
 * 活动数据
 **********************************************************/
ALProtocol Common_ActivityInfo
{
	//活动Id
	long activity;
	//当前活动阶段
	int curStep;
	//当前阶段已经完成的次数
	int curStepDoneTime;
	//当前阶段在服务器的完成状态
	bool curServerDoneState;
	//当前计数
	long curCounter;
	//是否已经看过
	bool isReaded;
}

/**********************************************************
 * 成就数据
 **********************************************************/
ALProtocol Common_AchieveInfo
{
	//成就Id
	long achieveId;
	//当前活动阶段
	int curStep;
	//当前阶段在服务器的完成状态
	bool curServerDoneState;
	//当前计数
	long curCounter;
}

/**********************************************************
 * 语音设置信息
 **********************************************************/
ALProtocol Common_VoiceSetting
{
	bool isSpeakerOn;
	bool isMicroOn;
}

/**********************************************************
 * 通用参与战斗玩家信息
 **********************************************************/
ALProtocol Common_FighterInfo
{
	//连胜场数
	int serialVictory;
	//连败场数
	int serialFail;
	//玩家段位
	int grades;
	//玩家星耀
	int starhoner;
	//传说积分
	long legendscore;
	//图标
	long icon;
	//天梯比赛次数
	int ladderFightNum;
	//总胜利次数
	int totalVictory;
	//总平局数
	int totalDraw;
	//总失败
	int totalFail;
	//1v1胜利次数
	int victory1v1;
	//2v2胜利次数
	int victory2v2;
	//客户端版本号
	string clientVersion;
	//图标框
	long iconBgk;
}

/**********************************************************
