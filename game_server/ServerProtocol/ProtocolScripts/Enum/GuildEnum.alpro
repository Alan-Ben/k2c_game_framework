}

ALEnum EGuildEventType[联盟事件类型]
{
	NONE;
	IMPEACH_LEADER[弹劾盟主];
}


ALEnum EGuildMarsHelpObjType[联盟火星互助类型]
{
	NONE;
	BUILDING_QUEUE[火星建筑队列];
	TECH_UP[火星科技升级];
