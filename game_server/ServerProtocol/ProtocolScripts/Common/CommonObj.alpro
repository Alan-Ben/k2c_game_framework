/**********************************************************
 * Common服向用户服发送邮件信息：全局邮件和个人邮件
 **********************************************************/
ALProtocol WCGCS2US_GlobalMail
{
	//全局邮件ID
	long gMailSID;
	//发送者名称
	string senderName;
	//邮件标题
	string title;
	//邮件内容
	string content;
	//奖励内容
	string reward;
	//创建时间
	int createTime;
	//存在时间
	int existTime;
	//发送给玩家类型(0全部玩家 1旧玩家 2新玩家 )
	int sendType;
	//指定渠道列表
	string[] channelList;
	//渠道列表发送或不发送
	bool isSend;
}

ALProtocol WCGCS2US_PersonalMail
{
	//发送者名称
	string senderName;
	//邮件标题
	string title;
	//邮件内容
	string content;
	//奖励内容
	string reward;
	//创建时间
	int createTime;
	//存在时间
	int existTime;
}

/**********************************************************
 * 邮件信息
 **********************************************************/
ALProtocol WCGGS2GC_MailBrief
{
	//邮件统一ID。数据库主键
	long sId;   
	//邮件标题
	string title;
	//邮件创建时间
	long createTime;
	//邮件阅读时间，未读是0
	long readTime;
	//邮件领取时间，未领取是0
	long pickUpTime;
	//发送者名称，为空客户端取默认值
	string senderName;
	//是否是奖励邮件
	bool isReward;
	//过期时间
	long expireTime;
} 
 
ALProtocol WCGGS2GC_MailDetails
{
	//邮件统一ID。数据库主键
