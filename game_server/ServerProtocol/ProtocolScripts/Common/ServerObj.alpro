ALProtocol ServerObj_PHPParam[平台参数]
{
	Enum.CommonEnum.EPlatParamType pKey;
	string pValue;
}
ALProtocol ServerObj_PHPParamList[平台参数列表]
{
	ServerObj_PHPParam[] pList;
}

ALProtocol ServerObj_PHPPlayer[平台获取的玩家明细信息]
{
	string uid[账号UID];
	long cid[角色CID];
	string name[用户名];
	int lvl[角色等级];
	int vip_lvl[VIP等级];
	int ar_time[注册时间-时间戳];
	int create_role_time[创角时间-时间戳];
	int last_login_time[最后登录时间-时间戳];
	double recharged_money[累计充值金额];
	double game_coin[剩余游戏币];
	double game_diamond[剩余钻石（充值转换币种）];
	long union_id[所属联盟ID];
	int union_position[所属联盟职位];
}

ALProtocol ServerObj_PHPMarqueeContent[平台获取的跑马灯内容信息]
{
	string lang[语言];
	string[] paramList[参数列表];
	string content[内容];
}

ALProtocol ServerObj_PHPMarquee[平台获取的跑马灯信息]
{
	long phpId[平台跑马灯ID];
	long refId[跑马灯配置ID 0-无配置];
	int showPosId[窗口展示队列];
	int priorityId[优先级（越大越优先）];
	int durationSec[循环播放时长秒（优先于次数）];
	int durationCount[循环播放次数];
	long uiResId[预制体ID];
	Enum.CommonEnum.EMarqueeCanDelType canDelType[是否可删除类型];
	int lifeSec[生存时间秒];
	Enum.ServerEnum.EMarqueeOfflineNeedShowType offlineNeedShowType[玩家离线期间是否需要展示];
	string defaultLang[默认语言];
	ServerObj_PHPMarqueeContent[] marqueeContentList[跑马灯多语言内容数据列表];
	string[] channelList[渠道列表];
	string showCondition[展示条件（客户端使用）];
}

