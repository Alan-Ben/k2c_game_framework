JavaPackage NPGC2GS.p001_BasicOp;
csharpspace NPGC2GS.p001_BasicOp;

/**********************************************************
 * 心跳包
 **********************************************************/
ALProtocol NPGC2GS_001_002_HeartPack <1, 2>
{
	//客户端事件标记
	long clientTimeTag;
	//预计的服务器时间标记，为0表示无效
	long calServerTimeTag;
	
	//客户端心跳包序列号，避免返回消息的心跳包触发非法处理
	//放在最后，可以新旧兼容
	long clientHeartSerialize;
}
