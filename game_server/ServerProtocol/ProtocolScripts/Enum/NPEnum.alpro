JavaPackage NPEnum;
csharpspace NPEnum;

ALEnum ENPLoginWayType[游戏登录方式，与文档账号类型相同 https\:\/\/thoughts.teambition.com\/share\/647e8f5e90a37b003eb87cf4]
{
	NONE;
    GUEST[游客];
    GAMECENTER[游戏圈账号登录  -- iOS支持 android不支持];
    IOS[Apple账号登录    -- iOS支持 android不支持];
    GOOGLE[谷歌账号登录    -- iOS不支持 android支持];
    FACEBOOK[facebook账号登录];
    VK[vk账号登录];
    LINE[line账号登录];
    TWITTER[twitter账号登录];
    MJ[梦加账号登录];
}

