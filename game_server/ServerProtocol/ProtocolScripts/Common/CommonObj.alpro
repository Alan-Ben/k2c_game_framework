ALProtocol Common_IntList
{
	int[] valueList;
}

ALProtocol Common_LongList
{
	long[] valueList;
}

ALProtocol Common_StringList
{
	string[] valueList;
}

ALProtocol Common_Int[用于需要引用传递的Integer的场景]
{
	int value;
}
ALProtocol Common_Long[用于需要引用传递的Long的场景]
{
	long value;
}

/**********************************************************
 * us info
 **********************************************************/
