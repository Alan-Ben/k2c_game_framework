JavaPackage NP2IS_RB.p001_ISOp;

ALProtocol NP2IS_RB_001_003_RetRegChatUser <1, 3>
{	
	string chatUid[聊天系统用户唯一标识];
	
	long systemId[聊天系统ID，用于区分不同大区的唯一标识，聊天用户UID的组成部分];
	string systemTag[聊天系统ID，用于区分不同大区的标签，聊天用户UID的组成部分];
	
	string ip[聊天服IP];
	int port[聊天服端口];
	string checkCode[登录密码];
	string areaTag[用户线路标识，即登录GS服务器标签];
}
