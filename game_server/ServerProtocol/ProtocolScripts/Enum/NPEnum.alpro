ALEnum ENPShareItemType[分享物品类型]
{
    NONE;
    BOX[宝箱];
}

ALEnum ENPHeroTag[英雄标记处理]
{
    NONE[无效属性];
    RANGE_ATT[远程];
    NEAR_ATT[近战];
