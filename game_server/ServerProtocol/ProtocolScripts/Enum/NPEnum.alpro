    MIDDAY_DUNGEON[午间副本];
    EVENING_DUNGEON[晚间副本];
	WALL_STREET[华尔街];
    CHILD_TRAIN[子嗣培养];
    DUNGEON_ENTRANCE[午间＆晚间boss合并入口];
    INN_MAIN[旅店主界面];
