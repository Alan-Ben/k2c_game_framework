﻿import Common.NPPlayerInfo.alpro;
JavaPackage GS2GC.p021_PlayerInfo;
csharpspace GS2GC.p021_PlayerInfo;

/**********************************************************
 * 玩家获得新头像的时候的推送消息
 **********************************************************/
ALProtocol GS2GC_021_006_PlayerIconAdd <21, 6>
{
	long id[头像唯一Id];
	int expireTimeTagS[超时时间标记，单位秒。-1表示永久];
	bool viewed[是否查看过];
}