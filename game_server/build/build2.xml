<project name="GOE_Server" default="build" basedir="./">
    <presetdef name="javac">
        <javac encoding="utf-8" debug="true" debuglevel="lines,vars,source" includeantruntime="false" source="1.8" target="1.8"/>
    </presetdef>
    <property name="target" value="1.8"/>
    <property name="source" value="1.8"/>
    <property name="src.home" value="../"/>
    <echo message="${src.home}"/>
    <target name="init">
        <delete dir="./out"/>
        <mkdir dir="./out"/>
        <copy tofile="./out/version.txt" file="./version.txt"/>

        <!--build libs lib -->
        <delete file="../Lib/Common.jar"/>
        <delete file="../Lib/ServerProtocol.jar"/>
        <delete file="../Lib/GameRes.jar"/>
        <delete file="../Lib/GameLogicCommon.jar"/>
        <path id="libpath">
            <fileset dir="${src.home}/Lib">
                <include name="**/*.jar"/>
            </fileset>
        </path>
    </target>

    <target name="delete">
        <!--build libs lib -->
        <delete file="../Lib/Common.jar"/>
        <delete file="../Lib/ServerProtocol.jar"/>
        <delete file="../Lib/GameRes.jar"/>
        <delete file="../Lib/GameLogicCommon.jar"/>
    </target>

    <!-- ServerProtocol -->
    <target name="ServerProtocol">
        <property name="ServerProtocol" value="${src.home}/ServerProtocol"/>
        <property name="ServerProtocol.sgr.dir" value="${ServerProtocol}/src"/>
        <property name="ServerProtocol.ps.dir" value="${ServerProtocol}/ProtocolScripts"/>
        <property name="ServerProtocol.dst.dir" value="${ServerProtocol}/temp"/>
        <delete dir="${ServerProtocol.dst.dir}"/>
        <mkdir dir="${ServerProtocol.dst.dir}"/>
        <javac srcdir="${ServerProtocol.sgr.dir}:${ServerProtocol.ps.dir}" destdir="${ServerProtocol.dst.dir}" nowarn="true" target="1.8">
            <classpath refid="libpath"/>
        </javac>
        <delete file="../Lib/ServerProtocol.jar"/>
        <jar jarfile="../Lib/ServerProtocol.jar">

            <exclude name="**/*.*"/>
            <fileset excludes="META-INF/*.SF" dir="${ServerProtocol.dst.dir}" includes="**/*.class"/>
            <fileset excludes="META-INF/*.SF" dir="${ServerProtocol.dst.dir}" includes="**/*.jar"/>
            <zipfileset excludes="META-INF/*.SF" src="../Lib/ALBasicServer.jar"/>
            <zipfileset excludes="META-INF/*.SF" src="../Lib/WCGBasicServer.jar"/>
        </jar>
        <delete dir="${ServerProtocol.dst.dir}"/>
    </target>

    <!--JavaAgent-->
    <target name="JavaAgent">
        <property name="JavaAgent" value="${src.home}/JavaAgent"/>
        <property name="JavaAgent.sgr.dir" value="${JavaAgent}/src"/>
        <property name="JavaAgent.dst.dir" value="${JavaAgent}/temp"/>
        <delete dir="${JavaAgent.dst.dir}"/>
        <mkdir dir="${JavaAgent.dst.dir}"/>
        <javac srcdir="${JavaAgent.sgr.dir}" destdir="${JavaAgent.dst.dir}" nowarn="true" target="1.8" source="1.7">
            <classpath refid="libpath"/>
        </javac>
        <delete dir="./out/JavaAgent"/>
        <mkdir dir="./out/JavaAgent"/>
        <jar jarfile="./out/JavaAgent/JavaAgent.jar">
            <manifest>
                <attribute name="Agent-Class" value="JavaAgent.JavaAgentMain"/>
                <attribute name="Can-Redefine-Classes" value="true"/>
                <attribute name="Can-Retransform-Classes" value="true"/>
            </manifest>
            <exclude name="**/*.*"/>
            <fileset dir="${JavaAgent.dst.dir}" includes="**/*.class"/>
            <fileset dir="${JavaAgent.dst.dir}" includes="**/*.jar"/>
        </jar>
        <delete dir="${JavaAgent.dst.dir}"/>
    </target>
	
