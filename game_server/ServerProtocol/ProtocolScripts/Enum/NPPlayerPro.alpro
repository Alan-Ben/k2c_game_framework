	MARS_EXPLORER_ATTACK_BOSS[火星探险-击败boss次数];
	MARS_EXPLORER_OCCUPY_MINE_NUM[火星探险-成功占领火星矿次数];
	MARS_BUILDING_MAX_POWER[火星所有建筑实力记录];
	MARS_TECH_MAX_POWER[火星所有科技实力记录];
	MARS_BUILDING_EQUIP_UP_NUM[火星所有建筑部件升级次数];
	MARS_PEOPLE_IMMIGRATION_NUM[火星移民次数];
	MARS_BUILDING_TEMP_QUEUE_TIMES[火星建筑临时队列创建次数];
	MARS_BUILDING_DISPATCH_NUM[火星探险-火星建筑派遣居民数量历史记录];
	MARS_PEOPLE_IMMIGRATION_SUM[火星移民数量];
	MARS_TIME_REDUCED_MIN_SUM[火星累计使用道具加速时长之和（分钟）];
	MARS_TECH_TIME_REDUCED_MIN_SUM[火星研究科技累计使用道具加速之和（分钟）];
	MARS_BUILD_TIME_REDUCED_MIN_SUM[火星建筑升级累计使用道具加速之和（分钟）];
	MARS_GET_ENERGY_COUNT[火星收取能源次数];
	MARS_TEAM_COLLECT_SUM[火星矿场采集资源量];
	TREASURE_HUNT_ACTIVE_ORE_SKILL_TIMES[太空寻宝激活矿石技能次数];
	MARS_TEAM_REPAIR_TIME_REDUCED_MIN_SUM[火星队伍修复累计使用道具加速之和（分钟）];
	TUTORIAL_DATA_MIGRATED[引导数据旧版本迁移已完成（仅服务端使用）];
