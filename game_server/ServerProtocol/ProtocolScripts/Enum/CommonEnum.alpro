ALEnum EBonusPropertyType[属性加成类型]
{
	NONE;
	TALENT[大臣资质加成];
	POWER[大臣实力绝对值加成];
	POWER_PER[大臣实力加成（万分比）];
	BONUS[建筑收益绝对值加成];
	EVENING_DUNGEON_POWER_PER[晚间副本实力加成（万分比）];
	FIN_STUDY_BONUS_PER[毕业收益加成（万分比）];
	BUILDING_PROFIT_ADD_PER[建筑收益加成（万分比）];
	INTIMACY[亲密度];
	CHARM[加护力];
	CHARMPOINT_PER[加护点加成（万分比）];
	MIDDAY_DUNGEON_HERO_ATTACK_EXTRA_TIMES[午间副本大臣额外攻击次数];
	ARENA_POWER_ADD_PER[竞技场实力加成（万分比）];
	CHILD_TRAIN_COST_PER[子嗣上课金币消耗减少加成（万分比）];
	CHILD_TRAIN_GAIN_PER[子嗣上课获得伙伴经验加成（万分比）];
	BUILDING_EMPLOYEE_REDUCE_PER[建筑雇佣成本减少加成（万分比）];
	CHARMPOINT[加护点（绝对值）];
	FIN_STUDY_BONUS[毕业收益加成（绝对值）];
	CHILD_TRAIN_GAIN[子嗣上课获得伙伴经验加成（绝对值）];
	ARENA_COINS[商会谈判战胜伙伴商会币加成（绝对值）];
	BUILDING_EMPLOYEE_PROFIT_ADD[建筑员工基础赚速加成（绝对值）];
	GIFT_CHILD_FIN_STUDY_BONUS[卷王子嗣毕业收益加成（万分比）];
	TREASURE_HUNT_TREASURE_OUTPUT_ADD[太空寻宝奇物产出加成];
	ARENA_GAIN_INFLUENCE_PER[竞技场影响力获得加成（万分比）];
}

