JavaPackage GOM2CD_R.gom_p001_DataOp;

/**********************************************************
 * 请求同步相关的数据
 * 此协议是开始同步的协议
 * 在开始同步的时候，为了确保数据同步，需要先清除原有US的数据
 **********************************************************/
ALProtocol GOM2CD_R_001_001_InitData <1, 1>
{
	int dataType[数据类型];
	long groupId[分组Id];
	int usId[US服务器Id];
}
