	TOWER_FIGHT_SUCCESS_TIMES[迷宫挑战成功次数];
	HERO_IMPROVE_STEP_TIMES[大臣提升阶数次数];
	TREASURE_HUNT_CAPTURE_TIMES[太空寻宝累计捕捉次数];
	DRAW_ACHIEVE_REWARD_TIMES[领取成就奖励次数];
	DEAL_HIRE_EMPLOYEE_PLOT[雇佣员工剧情];
	GAIN_GIFTED_CHILD_COUNT[获得卷王子嗣数量];
	INN_DISH_UPGRADE_TIMES[旅店菜品升级次数];
	TREASURE_HUNT_UPGRADE_ORE_NORMAL_SKILL_TIMES[太空寻宝升级矿石普通技能次数];
	TREASURE_HUNT_UPGRADE_ORE_ADVANCED_SKILL_TIMES[太空寻宝升级矿石高级技能次数];
	GUILD_COOPERATE_DRAW_RECORD_LAST_REFRESH_TIME_MS[联盟协作领取记录记录最后刷新时间 毫秒时间戳];
