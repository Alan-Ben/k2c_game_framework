ALProtocol ServerObj_PayCallbackInfo[支付回调信息]
{
	long dbId[数据库ID];
	string orderId[订单号];
	string sdkOrderId[SDK订单号];
	long cid[角色ID];
	string uid[用户ID];
	string appId[应用ID];
	long productId[产品ID];
	string amount[商品定价];
	string amountType[商品定价货币];
	string payType[支付方式（钱包聚合平台）];
	long createTime[创建时间（10位时间戳）];
	long payTime[支付时间（10位时间戳）];
	int sdkType[订单来源:1正常，2补单，3虚拟充值,4测试订单];
	string tradeId[第三方订单号];
	string skuId[第三方内购产品id];
	string sdkPayId[sdk档位ID];
	int purchaseType[购买类型：0普通，1测试，2促销，3奖励];
	string payment[实际支付金额];
	string paymentCode[实际支付货币];
	string channelCode[渠道标识(网页支付时玩家选择的站点标识)];
	string payId[支付ID（钱包ID）];
	int orderType[订单类型：1 内购，2 网页充值，3 福利（虚拟充值）];
}

