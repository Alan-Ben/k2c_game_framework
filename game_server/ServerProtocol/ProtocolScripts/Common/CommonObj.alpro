}

ALProtocol Common_GuildReqDonateInfo
{
	long id;
	//申请捐献公会玩家数据
	Common_GuildMemberInfo reqGuildMemberInfo;
	//请求捐献卡ID
	long cardId;
	//已经捐献数量
	int donateCount;
	//请求捐献的上限数量
	int reqDonateCountLimit;
	//请求捐献的时间戳
	int reqTimeTag;
	//请求捐献的过期时间戳
	int reqExpireTimeTag;
	//捐助玩家信息列表
	Common_GuildReqDonateCountInfo[] guildReqDonateCountInfoList;
}

/**********************************************************
