$Push 050 OnConsortAdd[家人新增推送]
{
   Common.ConsortObj.Consort_Info consort;
   Enum.ConsortEnum.EConsortSourceType sourceType[来源类型];
}

$Push 051 OnConsortIntimacyChg[家人亲密度推送]
{
	long consortId;
	long intimacy;
}

$Push 052 OnConsortCharmChg[家人加护力推送]
{
	long consortId;
	long charm;
}

$Push 053 OnConsortCharmPointChg[家人加护点推送]
{
	long consortId;
	long charmPoint;
}

$Push 054 OnTriggeredCallDlgIdAdd[已触发的邀约剧情ID推送]
{
	long consortId;
	long triggeredCallStroryId;
}

$Push 055 OnSkinAdd[家人新增皮肤推送]
{
	long consortId;
	Common.ConsortObj.Consort_SkinInfo skin[皮肤数据];
}

$Push 056 OnCurSkinChg[家人当前皮肤变更]
{
	long consortId;
	long curSkinId[当前皮肤ID];
}

$Push 057 OnFettersChg[家人羁绊数据变更]
{
	long consortId;
	Common.ConsortObj.Consort_Fetters fetters[家人羁绊数据];
}

$Push 058 OnBusinessSkillChg[家人经营技能数据变更]
{
	long consortId;
	Common.ConsortObj.Consort_BusinessSkill skill[家人经营技能数据];
}

$Push 059 OnBlessSkillChg[家人加护技能数据变更]
{
	long consortId;
	Common.ConsortObj.Consort_BlessSkill skill[家人加护技能数据];
}

$Push 060 OnHaloChg[家人星辉数据变更]
{
	long consortId;
	Common.ConsortObj.Consort_Halo halo[家人星辉数据];
}

$Push 061 OnCgChg[家人CG数据变更]
{
	Common.ConsortObj.Consort_CGInfo cg[家人CG数据];
}

$Push 062 OnRandCallConsortChg[随机邀约中指定的妃子ID列表变更]
{
	long[] consortIdList;
}