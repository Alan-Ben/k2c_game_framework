	DEAL_HERO_RECOMMEND[处理大臣推荐];
	ADD_FRIEND[添加好友];
	SEND_CHAT_TO_ROOM[聊天频道发言];
	EQUIP_RESHARP_TIMES[藏品重塑次数];
	RANK_FIXED_LIKE[常驻排行榜点赞];
	AVATAR_GACHA_ROLL[时装抽卡];
	UNLOCK_NEW_EQUIP_TYPE_COUNT[解锁藏品种类数量];
	MAX_EARNINGS_CHILD[赚速最高子嗣];
	ARENA_BEEN_DEFEAT_HERO_COUNT[竞技场累计被击败大臣数量];
	JOIN_GUILD_TIMES[加入联盟次数];
	ARENA_ATTACK_TIMES[竞技场挑战次数];
