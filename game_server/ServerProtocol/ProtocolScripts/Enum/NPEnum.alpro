/// 不需要保证客户端和服务器一定同步的效果，战斗相关之外的
/// （即有的有同步到服务器，有的没有，C开头的一般都是不需要同步到服务器的）
ALEnum ENPPlayerEffectType[玩家效果类型]
{
    NONE;
    C_UI_TO_SYS_SCE[跳转到系统界面  C_UI_TO_SYS_SCE:ESysSceneType];
    C_SPECIAL[客户端部分特殊效果  C_SPECIAL:EClientSpecialDealType];
    C_T_ENTER_DUNGEON[客户端测试进入dungeon地图  C_T_ENTER_DUNGEON:dungeonId];
    C_USE_BAG_ITEM[使用背包物品  C_USE_BAG_ITEM:itemId:（usecount）];
    C_ENTER_ACTOR_TEST[客户端进入单位测试地图 C_ENTER_ACTOR_TEST:dungeonId];
    C_DEAL_ID[针对ID的数据进行处理  C_DEAL_ID:EClientIDDealType:id];
    C_SHOW_ERR[展示错误信息  C_SHOW_ERR:key:args:args...];
    C_UI_SHOW_CUST_WND[显示自定义窗口 C_UI_SHOW_CUST_WND:assetPath:objName];

	//后续是对AnimatorControlMono脚本注册对象的处理
    C_ANI_PLAY[动作控制，对应动作播放，可自定义从某帧开始播normalizedTime：0~1， C_ANI_PLAY:animatorObjName:animatorStateName（:normalizedTime）];
    C_ANI_SET_BOOL[动作控制，设置动作布尔值  C_ANI_SET_BOOL:animatorObjName:variableName:value];
    C_ANI_SET_FLOAT[动作控制，设置动作浮点值 C_ANI_SET_FLOAT:animatorObjName:variableName:value];
    C_ANI_SET_INT[动作控制，设置动作整形值 C_ANI_SET_INT:animatorObjName:variableName:value];
    C_ANI_G_PLAY[动作控制，对应动作播放 C_ANI_G_PLAY:enum:animatorGroupName:animatorStateName];
    C_ANI_G_SET_BOOL[动作控制，设置动作布尔值  C_ANI_G_SET_BOOL:animatorGroupName:variableName:value];
    C_ANI_G_SET_FLOAT[动作控制，设置动作浮点值  C_ANI_G_SET_FLOAT:animatorGroupName:variableName:value];
    C_ANI_G_SET_INT[动作控制，设置动作整形值  C_ANI_G_SET_INT:animatorGroupName:variableName:value];

	UNUSE_S_S_EFFECT[已废弃];
	S_R_EFFECT[执行远端效果 S_R_EFFECT:id];
	S_GAIN_ITEM[获取物品 S_GAIN_ITEM:itemType-itemId:count#itemType-itemId:count];
	S_SPEND_ITEM[扣除物品（无需保证物品数量满足）S_SPEND_ITEM:itemType-itemId:count#itemType-itemId:count];
	S_GAIN_ITEM_FORM[获取物品（高级公式） S_GAIN_ITEM_FORM:itemType:count（高级公式）:倍数（高级公式）];
	S_CHG_BUFF[修改buff（不存在就新增，已存在在原基础上进行调整）  S_CHG_BUFF:buff_id:layer:timeS（秒：-1永久）];
	S_SET_BUFF[修改buff（不存在就新增，已存在在则替换原基础）  S_CHG_BUFF:buff_id:layer:timeS（秒：-1永久）];
	UNUSE_S_CHG_BUFF_TIME[已废弃];
	S_DEL_BUFF[移除buff  S_DEL_BUFF:buff_id];
	S_GAIN_REWARD[获取奖励 S_GAIN_REWARD:reward_id#reward_id...];
	S_START_QUEST[开启任务 S_START_QUEST:quest_id];
	S_QUEST_COUNTER_CHG[修改任务步骤计数 S_QUEST_COUNTER_CHG:quest_id:quest_step:quest_step_target:计数的变化数值（:ENCounterDealType默认ADD）];
	S_RECORD_CHG[修改玩家计数 S_RECORD_CHG:ENPPlayerRecordParam:计数的变化数值（:ENCounterDealType默认ADD）];
	S_UNLOCK_ARENA[解锁竞技场功能 S_UNLOCK_ARENA];
	S_EVENT_RECORD_CHG[修改玩家事件计数（操作枚举：） S_EVENT_RECORD_CHG:ENPPlayerEventRecordType:sub_id:计数的变化数值（:ENCounterDealType默认ADD）];
	S_DEAL_ID[服务端针对Id的数据进行处理的统一接口 S_DEAL_ID:ENPServerIDDealType:id];
	C_SHOWCASE_LOAD[showcase加载npc资源 C_SHOWCASE_LOAD:NPGShowcaseIndex:单位下标:NpcId];
	C_SHOWCASE_GRAY[showcase指定下标单位置灰 C_SHOWCASE_GRAY:NPGShowcaseIndex:单位下标:是否置灰];
	C_SPECIAL_DIALOGUE[客户端部分特殊对话效果 C_SPECIAL_DIALOGUE:ENPClientSpecialDoalogueDealType];
    C_WISH_QUEST_SHOWCASE_LOAD[showcase加载心愿任务宠物资源 C_WISH_QUEST_SHOWCASE_LOAD:NPGShowcaseIndex:单位下标];
    C_SHOWCASE_LOAD_PET[showcase加载宠物资源 C_SHOWCASE_LOAD_PET:ENPPlayerParam:NPGShowcaseIndex:单位下标];
    C_SEND_MSG[发送客户端自定义监听消息 C_SEND_MSG:WinMsgType];
    C_DEAL_PRIVATE_ITEM_ACTION[执行某个个人物件的某个action C_DEAL_PRIVATE_ITEM_ACTION:个人物件refId:action的refId:对应op的索引（从0开始，大部分action都只有一个op）];
    C_CAMERA_MOVE_FOCUS_TO[摄像头移动聚焦到某个位置（视野焦点世界坐标） C_CAMERA_MOVE_FOCUS_TO:（x,y,z）:duration];
    C_GOTO_EFFECT[执行effect_goto表里的effect: C_GOTO_EFFECT:id1:id2:...];
    C_ENTER_PRIVATE_ITEM_SIMPLE_PVE_BATTLE[进入一个个人物件挑战，布阵位置是固定的玩家初始阵型，宠物是玩家当前按战力顺序前5只];
    C_DEAL_STRING[针对String的数据进行处理  C_DEAL_STRING:EClientStringDealType:string];
    C_SPECIAL_SEND_EVENT[发送第三方埋点 C_SPECIAL_SEND_EVENT:EThirdCustomEventType];
    C_PREFAB_LOAD[为注册的加载对象，配合脚本PrefabControlMono使用 加载子对象 C_PREFAB_LOAD:tag:uiResPathId];

    S_RND_GAIN_X_BUSINESS_WORKERS[为随机建筑招募X位员工（数量） S_RND_GAIN_X_BUSINESS_WORKERS:数量];
    S_ANECDOTE_REFRESH[对政务指定刷新组进行刷新 S_ANECDOTE_REFRESH:刷新组id];
    S_UNLOCK_SEVEN_DAYS_LOGIN[解锁七日登录 S_UNLOCK_SEVEN_DAYS_LOGIN];
    S_GAIN_X_CONSORT_CHARM_FROM[给予已拥有的情人魅力值（情人id,数量） S_GAIN_X_CONSORT_CHARM_FROM:情人id（高级公式）:数量（高级公式）];
    S_GAIN_X_CONSORT_INTIMACY_FROM[给予已拥有的情人亲密度（情人id,数量） S_GAIN_X_CONSORT_INTIMACY_FROM:情人id（高级公式）:数量（高级公式）];
    S_GAIN_LAZY_CD[给予LAZY_CD（CdId,数量）S_GAIN_LAZY_CD:CdId:数量];
    C_CLOSE_NODE[关闭窗口节点，可指定节点 C_CLOSE_NODE（:nodeTag）];
	
	C_SHOWCASE_LOAD_SPEC[showcase加载指定类型资源 C_SHOWCASE_LOAD_SPEC:NPGShowcaseIndex:单位下标:EShowcaseLoadType];
	
	S_ADD_P_V[增加玩家数值（数量：定值），S_ADD_P_V:EEffectPlayerValueType:数量];
	S_ADD_P_V_FORM[增加玩家数值（数量：高级公式），S_ADD_P_V:EEffectPlayerValueType:高级公式];
	
	C_CAMERA_MOVE_FOCUS_TO_ENTRYPOINT[摄像头聚焦到当前存在的指定 entry_point C_Camera_Move_Focus_To_EntryPoint:entry_point_id:duration];
	S_LEVY_ADD_COUNT[征收增加次数，S_LEVY_ADD_COUNT:征收类型枚举ELevy_Type（当前只有士兵征收有效）:数量];
	
	S_GAIN_AND_SET_CUTE_ACTOR[获得且设置Q版形象 S_GAIN_AND_SET_CUTE_ACTOR:Q版形象ID（:时间（秒），默认为0）];
	C_SHOWCASE_MAGICA_CLOTH[showcase指定下标单位开启关闭魔法布料物理效果 C_SHOWCASE_MAGICA_CLOTH:NPGShowcaseIndex:单位下标:是否开启];
	C_SHOW_BATCH_USE_ITEM_WND[打开批量使用道具窗口 C_SHOW_BATCH_USE_ITEM_WND:itemId];
	C_SHOWCASE_PLAY_SFX[showcase在指定index播放sfx，要求这个index有对象了 C_SHOWCASE_LOAD:NPGShowcaseIndex:单位下标:sfxId];
	C_CAMERA_MOVE_TO[摄像头移动到某个位置（世界坐标） C_CAMERA_MOVE_TO:（x,y,z）:duration];
	C_PLAY_FUNC_UNLOCK_PROCESS[播放系统解锁表现过程，C_PLAY_FUNC_UNLOCK_PROCESS:ENPFunctionType（:是否使用notice）];
	C_REFRESH_ENTRY_STATE[刷新入口状态，C_REFRESH_ENTRY_STATE:ENPFunctionType];
	C_PREFAB_DISCARD[配合脚本PrefabControlMono使用，销毁子对象，C_PREFAB_DISCARD:tag];
	C_SET_CLOTHES_UNIT[设置avatar穿戴部件，如果多个部件后面直接接上id，C_SET_CLOTHES_UNIT:部件id:部件id...];
	C_PLAY_DIALOG_AUDIO[播放对话音效 C_PLAY_DIALOG_AUDIO:音效refId:音效layer:需要停止的音效layer列表（列表中元素用,分割）];
	S_CHG_LEVY_SILVER_TIME[修改可征收金币时间，S_CHG_LEVY_SILIVER_TIME:ENPTimeAddType（SET、ADD）:时间（秒）];
	
	C_SEND_MSG_WITH_PARAM[发送客户端自定义监听消息 C_SEND_MSG:WinMsgType:自定义参数];
	
	S_GAIN_X_CONSORT_LIKE_FROM[给予未拥有的情人好感度（情人id,数量） S_GAIN_X_CONSORT_LIKE_FROM:情人id:数量（高级公式）];
	
	C_ANI_SET_ANI[动作控制，强制设置动画 C_ANI_SET_ANI:animatorObjName:aniName];
	C_ANI_G_SET_ANI[动作控制，强制设置动画 C_ANI_G_SET_ANI:animatorGroupName:aniName];
	C_HOTFIX_EFFECT[热更操作类型 C_HOTFIX_EFFECT:操作类型:参数（参数可不填）];
	
	S_GAIN_X_CONSORT_CHARM_POINT_FROM[给予已拥有的情人加护力点（情人id，数量，倍数） S_GAIN_X_CONSORT_CHARM_POINT_FROM:情人id（高级公式）:数量（高级公式）(:倍数，默认1)];

	S_GAIN_X_CHILD_EXP_POINT_FROM[给予未成年子嗣增加经验（子嗣实例id，数量，倍数） S_GAIN_X_CHILD_EXP_POINT_FROM:未成年id（高级公式）:数量（高级公式）(:倍数，默认1)];

	S_MARS_CHG_MOOD[火星系统：修改心情指数（额外），S_MARS_CHG_MOOD:count数量];
	S_MARS_CURE[火星系统：治疗数量，S_MARS_CURE:数量（-1 全部病人）];
	S_MARS_RND_B_RND_SICK[火星系统：随机建筑（需要有工作居民）随机1~n个居民进入医疗室，S_MARS_RND_B_RND_SICK];
	S_MARS_RND_B_RND_LOST[火星系统：随机建筑随机（需要有工作居民）减少1~n个居民，S_MARS_RND_B_RND_LOST];
	S_MARS_GAIN_ENERGY[火星系统：立即获得N小时产出的能源，S_MARS_GAIN_ENERGY:mins（分钟）];
	
	S_GAIN_REWARD_FORM[获取奖励（高级公式） S_GAIN_REWARD_FORM:reward_id（高级公式）:倍数（高级公式）];
	S_INN_ADD_GUEST[旅店系统：增加接待客人数量，S_INN_ADD_GUEST:数量];
	C_TRY_TRIGGER_PUSH_GIFT_PACK[尝试触发推送礼包 C_TRY_TRIGGER_PUSH_GIFT_PACK:礼包组id];
	
	C_PLAY_AUDIO[客户端枚举];
	S_CHG_BIRTH_GIFTDE_COUM[增加卷王子嗣次数 S_CHG_BIRTH_GIFTDE_COUM:数量（:ENCounterDealType默认ADD）];
}

